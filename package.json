{
  "name": "algolens",
  "version": "0.1.0",
  "private": true,
  "description": "DSA problem search engine \u2014 learning project",
  "main": "server/index.js",
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",
    "embed": "node scripts/embed_corpus.js",
    "validate": "node scripts/validate_corpus.js",
    "corpus:refresh": "bash scripts/refresh_corpus.sh",
    "bench": "node bench/run.js",
    "bench:fast": "LATENCY_REPEATS=5 node bench/run.js",
    "bench:diff": "node bench/diff.js",
    "test:search": "node server/search/tfidf.test.js && node server/search/bm25.test.js && node server/search/dense.test.js && node server/search/hybrid.test.js && node server/search/query_expand.test.js && node server/routes/search.test.js",
    "test:profile": "node server/profile/profile.test.js",
    "db:migrate": "bash db/run-migrations.sh",
    "services:start": "docker compose up -d",
    "services:stop": "docker compose down",
    "services:status": "docker compose ps",
    "services:reset": "docker compose down -v",
    "app:start": "bash scripts/start.sh",
    "app:stop": "bash scripts/stop.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.13",
    "@huggingface/transformers": "4.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
